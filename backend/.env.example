# =============================================================================
# MediCare Backend — Environment Variables
# =============================================================================
# Copy this file to .env and fill in the values for your local environment.
# Never commit .env to version control.
# =============================================================================

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
# Port the NestJS API listens on (default: 3001 to avoid conflict with Next.js)
PORT=3001

# Frontend origin allowed for CORS (default: Next.js dev server)
CORS_ORIGIN=http://localhost:3000

# ---------------------------------------------------------------------------
# Database (Issue #8 — TypeORM configuration will go here)
# ---------------------------------------------------------------------------
# Use SQLite for local development (zero setup)
# DB_TYPE=sqlite
# DB_DATABASE=./medicare.sqlite

# Use free PostgreSQL tier for shared/demo environments (Neon, Supabase, etc.)
# DB_TYPE=postgres
# DB_HOST=localhost
# DB_PORT=5432
# DB_USERNAME=medicare
# DB_PASSWORD=change_me
# DB_DATABASE=medicare_dev
# DB_SSL=false
# DB_SYNC=true      # true for dev only — use migrations in production

# ---------------------------------------------------------------------------
# JWT Auth (Issue #28 — Auth module will use these)
# ---------------------------------------------------------------------------
# JWT_SECRET=change_me_to_a_long_random_secret
# JWT_EXPIRES_IN=7d

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
NODE_ENV=development
